{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }


  #shopify-section-{{ section.id }} .list__ad-item {
    position: relative;
    cursor: pointer;
    width: 100%;
    max-width: 200px;
    height: 180px;
    background-size: cover;
    background-repeat: no-repeat;
    border-radius: 2rem;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .list__ad-item img {
    width: 100%;
    border-radius: 0.5rem;
  }

  #shopify-section-{{ section.id }} .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.8);
  }

  #shopify-section-{{ section.id }} .modal-content {
    margin: auto;
    padding: 1rem;
    width: 80%;
    max-width: 800px;
    border-radius: 0.5rem;
    left: 0;
    right: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .close {
    position: absolute;
    top: -10px;
    right: -10px;
    color: #000;
    font-size: 2rem;
    font-weight: bold;
    cursor: pointer;
    background-color: #fff;
    width: 30px;
    height: 30px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100%;
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="page-width color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="tw-flex tw-justify-center tw-mb-10 tw-items-center tw-gap-10">
        <p
        class="tw-m-0 image-with-text__heading inline-richtext tw-font-bold"
        style="min-width: max-content;"
        {{ section.shopify_attributes }}
        >
        {{ section.settings.heading }}
        </p>
        <hr class="tw-m-0 tw-h-[0.2rem] tw-bg-accent-1 tw-w-full tw-mx-auto tw-bg-white">
    </div>

    <div class="video-list tw-flex tw-flex-wrap tw-gap-10 tw-justify-center lg:tw-justify-start">
      {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when 'video_ad' -%}
            <div class="list__ad-item"  data-video-url="{{ block.settings.video_url }}">
              {% comment %} <img src="{{ block.settings.video_thumbnail_url }}" alt="Video Thumbnail"> {% endcomment %}
               <div class="!tw-block tw-bg-cover tw-bg-center tw-absolute tw-inset-0" style="background-image: url('{{ block.settings.video_thumbnail_url }}');"></div>
            </div>
            {%- when 'image_ad' -%}
               
            {% if block.settings.image %}
                <div class="list__ad-item image_ad" data-img="{{ block.settings.image | img_url: 'master' }}">
                    <div class="!tw-block tw-bg-cover tw-bg-center tw-absolute tw-inset-0" style="background-image: url('{{ block.settings.image | img_url: 'master' }}');"></div>
                </div>
            {% else %}
                <div class="list__ad-item" data-img="{{ block.settings.image_url | img_url: 'master' }}">
                    <div class="!tw-block tw-bg-cover tw-bg-center tw-absolute tw-inset-0" style="background-image: url('{{ block.settings.image_url | img_url: 'master' }}');"></div>
                </div>
            {% endif %}
                
        {%- endcase -%}
      {% endfor %}
    </div>

    <div id="videoModal-{{ section.id }}" class="modal">
      <div class="modal-content gradient-box">
        <span class="close">&times;</span>
        <div class="tw-flex" id="videoContainer-{{ section.id }}"></div>
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var modal = document.querySelector('#shopify-section-{{ section.id }} #videoModal-{{ section.id }}');
        var videoContainer = document.querySelector('#shopify-section-{{ section.id }} #videoContainer-{{ section.id }}');
        var closeBtn = document.querySelector('#shopify-section-{{ section.id }} .close');

        document.querySelectorAll('#shopify-section-{{ section.id }} .list__ad-item').forEach(function(item) {
            item.addEventListener('click', function() {
                if (this.classList.contains('image_ad')) {
                    var imageUrl = this.getAttribute('data-img');
                    videoContainer.innerHTML = '<img src="' + imageUrl + '" style="width: 100%; height: auto;" />';
                } else {
                    var videoUrl = this.getAttribute('data-video-url') + '?autoplay=1';
                    videoContainer.innerHTML = '<iframe width="100%" height="400" src="' + videoUrl + '" frameborder="0" allow="autoplay" allowfullscreen></iframe>';
                }
                modal.style.display = 'block';
            });
        });

        closeBtn.onclick = function() {
            modal.style.display = 'none';
            videoContainer.innerHTML = '';
        }

        window.onclick = function(event) {
            if (event.target == modal) {
                modal.style.display = 'none';
                videoContainer.innerHTML = '';
            }
        }
    });
</script>

{% schema %}
{
  "name": "Ad List",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Clients",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Margin Top",
        "default": 40
    },
    {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Margin Bottom",
        "default": 52
    }
  ],
  "blocks": [
    {
      "type": "video_ad",
      "name": "Video Ad",
      "settings": [
        {
            "type": "text",
            "id": "ad_title",
            "label": "Ad Title"
        },
        {
            "type": "url",
            "id": "video_url",
            "label": "Video URL"
        },
        {
            "type": "url",
            "id": "video_thumbnail_url",
            "label": "Video Thumbnail URL"
        }
      ]
    },
    {
        "type": "image_ad",
        "name": "Image Ad",
        "settings": [
            {
                "type": "text",
                "id": "ad_title",
                "label": "Ad Title"
            },
          {
              "type": "image_picker",
              "id": "image",
              "label": "Image"
          },
          {
              "type": "url",
              "id": "image_url",
              "label": "Image URL"
          }
        ]
      }
  ],
  "presets": [
    {
      "name": "Ad List"
    }
  ]
}
{% endschema %}